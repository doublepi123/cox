{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": { "entry": ["scripts/dev-runner.ts", "vite.config.ts"], "project": ["scripts/**/*.ts"] },
    "apps/server": {
      "entry": ["src/bin.ts", "src/claude-history-worker.ts"],
      "project": ["src/**/*.ts"],
    },
    "apps/web": { "entry": ["src/main.tsx"], "project": ["src/**/*.{ts,tsx}"] },
    "packages/*": { "entry": ["src/**/*.ts"], "project": ["src/**/*.ts"] },
  },
}
